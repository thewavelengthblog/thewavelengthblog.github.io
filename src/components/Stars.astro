---
const { rating, size = 16 } = Astro.props;
const pct = Math.max(0, Math.min(100, (rating / 5) * 100));
---
<span class="stars" data-pagefind-ignore role="img" aria-label={`${rating} out of 5 stars`} style={`font-size:${size}px`}>
  <span class="stars-off" aria-hidden="true">★★★★★</span><span class="stars-on" aria-hidden="true" style={`width:${pct}%`}>★★★★★</span>
</span>
