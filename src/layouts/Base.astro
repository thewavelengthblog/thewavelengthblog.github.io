---
import '@fontsource/bebas-neue/400.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '../styles/global.css';
import { site } from '../site.config.mjs';
import Subscribe from '../components/Subscribe.astro';

const { title, description = site.description, image } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : null;
const isCurrent = (href) => (path.startsWith(href) ? 'page' : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/">{site.name}</a>
        <nav class="nav" aria-label="Sections">
          <a href="/movies/" aria-current={isCurrent('/movies')}>Movies</a>
          <a href="/culture/" aria-current={isCurrent('/culture')}>Culture</a>
          <a href="/about/" aria-current={isCurrent('/about')}>About</a>
        </nav>
        <div class="header-actions">
          <a class="icon-btn" href="/search/" aria-label="Search">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
          </a>
          <a class="pill" href="#subscribe">{site.subscribeFormAction ? 'Subscribe' : 'Follow'}</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <Subscribe />

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span><a href="/movies/">Movies</a> · <a href="/culture/">Culture</a> · <a href="/rss.xml">RSS</a></span>
      </div>
    </footer>
  </body>
</html>
