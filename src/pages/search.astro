---
import Base from '../layouts/Base.astro';
---
<Base title="Search">
  <link slot="head" rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <div class="narrow page-head">
    <h1 class="page-title">Search</h1>
  </div>
  <div class="narrow">
    <div class="search-box" id="search"></div>
  </div>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', function () {
      new PagefindUI({ element: '#search', showSubResults: false, showImages: false, autofocus: true });
    });
  </script>
</Base>
